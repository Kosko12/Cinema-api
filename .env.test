APP_ENV=test
APP_SECRET=test_secret_key

# For Docker: Use cinema_user and cinema_password from compose.yaml
# Note: Doctrine will add _test suffix automatically, so use cinema_db as base name
DATABASE_URL="mysql://cinema_user:cinema_password@127.0.0.1:3306/cinema_db?serverVersion=8.0&charset=utf8mb4"
# For local MySQL without Docker, use:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/cinema_db?serverVersion=8.0&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme
