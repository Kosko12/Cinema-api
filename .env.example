# Application environment (dev, prod, test)
APP_ENV=dev

# Application secret key (generate with: php -r "echo bin2hex(random_bytes(32));")
APP_SECRET=changeme_please_generate_a_secret_key

# Database connection URL
# For Docker Compose (recommended):
DATABASE_URL="mysql://cinema_user:cinema_password@127.0.0.1:3306/cinema_db?serverVersion=8.0&charset=utf8mb4"
# For local MySQL installation:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/cinema_db?serverVersion=8.0&charset=utf8mb4"

# JWT Configuration
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme
